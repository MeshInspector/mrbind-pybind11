@PACKAGE_INIT@

if(@PYBIND11_NONLIMITEDAPI_BUILD_STUBS@)
  include("${CMAKE_CURRENT_LIST_DIR}/pybind11nonlimitedapi_stubs-targets.cmake")
  check_required_components(pybind11nonlimitedapi_stubs)
endif()

if(NOT "@PYBIND11_NONLIMITEDAPI_SUFFIX@" STREQUAL "")
  include("${CMAKE_CURRENT_LIST_DIR}/@PYBIND11_NONLIMITEDAPI_LIBNAME@-targets.cmake")
  set(pybind11nonlimitedapi_SHIM_PYTHON_VERSION "@Python_VERSION_MAJOR@.@Python_VERSION_MINOR@")
  set(pybind11nonlimitedapi_SHIM_TARGET pybind11nonlimitedapi::@PYBIND11_NONLIMITEDAPI_LIBNAME@)
endif()
