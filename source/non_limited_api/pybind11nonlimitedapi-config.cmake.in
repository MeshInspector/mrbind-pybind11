@PACKAGE_INIT@

if(@PYBIND11_NONLIMITEDAPI_BUILD_STUBS@)
  include("${CMAKE_CURRENT_LIST_DIR}/pybind11nonlimitedapi_stubs-targets.cmake")
  check_required_components(pybind11nonlimitedapi_stubs)
endif()

if(NOT "@PYBIND11_NONLIMITEDAPI_SUFFIX@" STREQUAL "")
